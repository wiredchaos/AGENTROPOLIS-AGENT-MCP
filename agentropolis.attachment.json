  "authority_boundary": { "may_redefine_city_law": false, "may_bypass_policy": false, "may_self_grant_permissions": false, "may_execute_wallet_actions": false, "may_publish_externally": false, "may_mutate_permissions": false, "may_perform_destructive_actions": false },
  "validation": { "owner": "NEURO", "commands": ["npm run validate", "npm test", "npm run deploy:dry"], "receipt_required": true }
}
