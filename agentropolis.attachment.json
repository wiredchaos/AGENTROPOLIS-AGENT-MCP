  "layer": "infrastructure",
  "role": "Governed Cloudflare MCP, tool-routing, validation, receipt, and execution membrane for the Agentropolis Intelligence Grid",
  "status": "deployment_ready",
  "district": null,
  "application": "agent-mcp-capability-membrane",
  "runtime": { "provider": "cloudflare", "service": "workers", "transport": "mcp-streamable-http", "static_assets": true, "database": "d1", "observability": true },
  "routes": ["https://<worker-domain>/", "https://<worker-domain>/mcp", "https://<worker-domain>/health", "https://<worker-domain>/.well-known/mcp.json"],
